<dependencies>
  <!--
    ZeyWinAds SDK Android dependencies.

    - installreferrer is bundled as AAR in Runtime/Plugins/Android/ (rare lib, no conflicts).
    - Google Play Services are resolved via Gradle/EDM4U (common libs, bundling causes duplicates).

    If your project does NOT use EDM4U, add these to your mainTemplate.gradle:
      implementation 'com.google.android.gms:play-services-ads-identifier:18.0.1'
  -->
  <androidPackages>
    <androidPackage spec="com.google.android.gms:play-services-ads-identifier:18.0.1" />
  </androidPackages>
</dependencies>
